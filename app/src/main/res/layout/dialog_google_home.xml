<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="720dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="26dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 Google Home"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Gekoppelde apparaten via home.google.com"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/badge_home_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="Smart Home"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Section 1: Slaapkamer -->
    <TextView
        android:id="@+id/tv_home_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="SLAAPKAMER (3 APPARATEN)"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <!-- Device 1: 32PFS6906/12 (TV) -->
        <LinearLayout
            android:id="@+id/card_device_tv"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusRight="@+id/card_device_bed"
            android:nextFocusDown="@+id/card_device_speaker_secondary"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_selector"
                android:gravity="center"
                android:text="📺"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_device_tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Android TV"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deze TV • Aan"
                    android:textColor="#34D399"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Device 2: Bed (Light) -->
        <LinearLayout
            android:id="@+id/card_device_bed"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@+id/card_device_tv"
            android:nextFocusRight="@+id/card_device_speaker_primary"
            android:nextFocusDown="@+id/card_device_speaker_secondary"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/icon_device_bed"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_selector"
                android:gravity="center"
                android:text="💡"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bed"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_bed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uit"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Device 3: Smart Speaker -->
        <LinearLayout
            android:id="@+id/card_device_speaker_primary"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@+id/card_device_bed"
            android:nextFocusDown="@+id/card_device_speaker_secondary"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/icon_device_speaker_primary"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_selector"
                android:gravity="center"
                android:text="🔊"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_name_speaker_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Smart Speaker"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_speaker_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Standby"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Section 2: Extra Devices -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="EXTRA APPARATEN"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:orientation="horizontal">

        <!-- Device 4: Extra Speaker -->
        <LinearLayout
            android:id="@+id/card_device_speaker_secondary"
            android:layout_width="220dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/card_device_tv"
            android:nextFocusDown="@+id/btn_open_google_home_web"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/icon_device_speaker_secondary"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_selector"
                android:gravity="center"
                android:text="🔊"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_name_speaker_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Extra Speaker"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_speaker_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Standby"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_open_google_home_web"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:nextFocusUp="@+id/card_device_speaker_secondary"
            android:nextFocusRight="@+id/btn_close_home"
            android:text="🌐 Open Google Home Web (home.google.com)"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_close_home"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:nextFocusLeft="@+id/btn_open_google_home_web"
            android:nextFocusUp="@+id/card_device_speaker_secondary"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Sluiten"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
